{
  "expo": {
    "name": "UCL Match Model",
    "slug": "ucl-match-model",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F4D"
    },
    "ios": {
